# Application Settings
APP_NAME=IBSS Superstocks Dashboard
DEBUG=True
API_VERSION=v1

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://ibss:ibss_password@localhost:5432/ibss_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# JWT Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External APIs
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=
SEC_EDGAR_USER_AGENT=IBSS Dashboard admin@example.com

# Screening
DEFAULT_SCREEN_LIMIT=100
MAX_SCREEN_LIMIT=1000

# Risk Management
DEFAULT_RISK_PER_TRADE=0.02
MAX_POSITION_SIZE=0.40
